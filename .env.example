# ─────────────────────────────────────────────────────────────
# CHASE HomePath — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ── Database (self-hosted PostgreSQL — Hetzner in prod) ──
# Either provide DATABASE_URL, or the individual PG* parts below.
DATABASE_URL=postgres://chase:chase@localhost:5432/chase_homepath
PGHOST=localhost
PGPORT=5432
PGUSER=chase
PGPASSWORD=chase
PGDATABASE=chase_homepath
# Set to "require" when the DB requires TLS (production).
PGSSLMODE=disable

# ── Auth ──
# 32+ char random secrets. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=2592000     # seconds (30 days)

# MFA (TOTP) issuer label shown in authenticator apps
MFA_ISSUER=CHASE HomePath

# ── Column-level encryption (GLBA-grade, Section 8) ──
# AES-256-GCM. 32-byte key, base64-encoded. Generate: openssl rand -base64 32
# Rotating: append new keys as ENCRYPTION_KEY_2, _3 ... ; ENCRYPTION_KEY_ACTIVE picks which encrypts.
ENCRYPTION_KEY=change-me-32-byte-base64-key-goes-here-aaaaaaaa=
ENCRYPTION_KEY_ACTIVE=1

# ── CORS (comma-separated origins for the three surfaces) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Integration adapters (later phases; keys blank until then) ──
# Every third party sits behind an adapter — providers here are swappable.
PLAID_ADAPTER=mock
CREDIT_BUREAU_ADAPTER=mock
MLS_ADAPTER=mock
ESIGN_ADAPTER=mock
LICENSE_LOOKUP_ADAPTER=mock
VIDEO_ADAPTER=mock
ANTHROPIC_ADAPTER=mock
ANTHROPIC_API_KEY=
